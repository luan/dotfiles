#!/usr/bin/env bash
set -euo pipefail

real_brew_path() {
    if [[ -n "${HOMEBREW_REAL_BREW:-}" && -x "$HOMEBREW_REAL_BREW" ]]; then
        printf '%s\n' "$HOMEBREW_REAL_BREW"
        return 0
    fi

    local self_dir self candidate candidate_dir
    self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
    self="$self_dir/$(basename "${BASH_SOURCE[0]}")"

    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
        [[ -x "$candidate" ]] || continue
        candidate_dir="$(cd "$(dirname "$candidate")" && pwd -P)"
        [[ "$candidate_dir/$(basename "$candidate")" == "$self" ]] && continue
        printf '%s\n' "$candidate"
        return 0
    done

    echo "brew shim: real Homebrew binary not found" >&2
    exit 127
}

zb_path() {
    local candidate

    for candidate in "${ZEROBREW_BIN:-}/zb" "$HOME/.local/bin/zb" /opt/zerobrew/bin/zb; do
        [[ -n "$candidate" && -x "$candidate" ]] || continue
        printf '%s\n' "$candidate"
        return 0
    done

    command -v zb 2>/dev/null || return 1
}

prefer_zerobrew_install() {
    local zb output zb_status brew_status

    if ! zb="$(zb_path)"; then
        echo "brew shim: zb not found; falling back to Homebrew install" >&2
        exec "$real_brew" install "$@"
    fi

    if output="$("$zb" install "$@" 2>&1)"; then
        [[ -z "$output" ]] || printf '%s\n' "$output"
        return 0
    else
        zb_status=$?
    fi

    echo "brew shim: zb install failed with exit $zb_status; falling back to Homebrew install" >&2

    if "$real_brew" install "$@"; then
        return 0
    else
        brew_status=$?
    fi

    echo "brew shim: Homebrew install also failed; zerobrew output was:" >&2
    printf '%s\n' "$output" >&2
    return "$brew_status"
}

real_brew="$(real_brew_path)"

if [[ "${HOMEBREW_ALLOW_FORMULA:-}" == "1" ]]; then
    exec "$real_brew" "$@"
fi

cmd="${1:-}"
case "$cmd" in
    install)
        shift
        prefer_zerobrew_install "$@"
        ;;
    *)
        exec "$real_brew" "$@"
        ;;
esac
