theme = tokyonight
#theme = light:Catppuccin Latte, dark:tokyonight

desktop-notifications = true
shell-integration-features = ssh-terminfo
shell-integration-features = ssh-env

shell-integration-features = ssh-terminfo
shell-integration-features = ssh-env

font-family = "Maple Mono NF Light"

font-size = 11.75

cursor-style-blink = true
cursor-style = bar

palette-generate = true
palette-harmonious = true

adjust-cell-height = 45%
adjust-font-baseline = 3
adjust-underline-position = 25%
adjust-underline-thickness = 1

# window-decoration = "none"
window-padding-balance = true
window-padding-color = "extend"

fullscreen = "non-native"
macos-non-native-fullscreen = true
macos-window-shadow = false
macos-titlebar-proxy-icon = hidden
macos-icon = xray

copy-on-select = true
mouse-hide-while-typing = true

background-opacity = 1
unfocused-split-opacity = 0.85
scrollback-limit = 10000000
macos-option-as-alt = left

keybind = super+,=text:ghostty +edit-config\n
config-file = ?tode/keybinds.ghostty
