# Zsh environment — sourced for every shell (interactive, login, scripts).
# Keep this idempotent and fast; heavy work belongs in .zshrc.
# Do not set ZDOTDIR here: ~/.zshrc is the local entrypoint and sources the
# repo-managed ~/.config/zsh/zshrc explicitly.

export XDG_CONFIG_HOME="$HOME/.config"

# Homebrew is optional. Support Apple Silicon, Intel macOS, Linuxbrew, and
# machines without Homebrew.
for _brew_bin in /opt/homebrew/bin /usr/local/bin "$HOME/.linuxbrew/bin" "$HOME/.linuxbrew/sbin"; do
  if [[ -x "$_brew_bin/brew" ]]; then
    path=("$_brew_bin" $path)
  fi
done
if (( $+commands[brew] )); then
  export HOMEBREW_PREFIX="$(brew --prefix)"
  export HOMEBREW_CELLAR="$(brew --cellar)"
  export HOMEBREW_REPOSITORY="$(brew --repository)"
  export INFOPATH="$(brew --prefix)/share/info:${INFOPATH:-}"
fi
for _cert_var in SSL_CERT_FILE CURL_CA_BUNDLE SSL_CERT_DIR NODE_EXTRA_CA_CERTS REQUESTS_CA_BUNDLE; do
  if [[ ${(P)_cert_var:-} == /opt/zerobrew/* ]]; then
    unset $_cert_var
  fi
done
unset _cert_var


export EDITOR=nvim
export GIT_EDITOR=nvim
export GIT_USERNAME=luan

export BUN_INSTALL="$HOME/.bun"
export VCPKG_ROOT="$HOME/vcpkg"
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'

typeset -U path
path=("$HOME/.local/lib/kache/shims" "$HOME/bin" "$HOME/.local/bin" "$BUN_INSTALL/bin" "$HOME/.cargo/bin" $path)
export PATH

[[ -r "$HOME/.config/vite-plus/env" ]] && source "$HOME/.config/vite-plus/env"

# Slack MCP OAuth client registers this localhost redirect port.
export MCP_OAUTH_CALLBACK_PORT=3118
