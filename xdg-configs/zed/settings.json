// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "edit_predictions": {
    "provider": "copilot"
  },
  "bottom_dock_layout": "contained",
  "outline_panel": {
    "button": true,
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "status_bar": {
    "show_active_file": true,
    "line_endings_button": false,
    "active_language_button": true,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "document_symbols": "on",
  "document_folding_ranges": "on",
  "semantic_tokens": "combined",
  "code_lens": "on",
  "inlay_hints": {
    "enabled": true,
  },
  "autosave": "off",
  "text_rendering_mode": "platform_default",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Catppuccin Mocha",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "agent_servers": {
    "cursor": {
      "type": "registry"
    },
    "codex-acp": {
      "favorite_config_option_values": {
        "reasoning_effort": [
          "medium",
          "high",
          "low"
        ]
      },
      "default_config_options": {
        "reasoning_effort": "medium"
      },
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "pi-acp": {
      "type": "registry",
    },
  },
  "cli_default_open_behavior": "existing_window",
  "title_bar": {
    "show_user_menu": true,
    "show_menus": false,
    "show_branch_status_icon": true,
    "show_sign_in": false,
    "show_user_picture": false,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_branch_name": true,
    "button_layout": null,
  },
  "project_panel": {
    "bold_folder_labels": true,
    "entry_spacing": "comfortable",
    "dock": "right",
    "button": true,
  },
  "toolbar": {
    "code_actions": true,
    "breadcrumbs": true,
  },
  "language_models": {
    "openai_compatible": {},
  },
  "base_keymap": "Cursor",
  "agent": {
    "sidebar_side": "left",
    "default_height": 900.0,
    "button": true,
    "dock": "left",
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.4-mini",
      "enable_thinking": true,
      "effort": "medium",
    },
    "default_profile": "write",
    "profiles": {
      "write": {
        "name": "Write",
        "tools": {
          "open": true,
          "create_directory": true,
          "terminal": true,
          "batch_tool": true,
          "code_actions": true,
          "code_symbols": true,
          "copy_path": true,
          "create_file": true,
          "delete_path": true,
          "diagnostics": true,
          "edit_file": true,
          "fetch": true,
          "list_directory": true,
          "move_path": true,
          "now": true,
          "find_path": true,
          "read_file": true,
          "grep": true,
          "rename": true,
          "symbol_info": true,
          "thinking": true,
        },
        "enable_all_context_servers": true,
        "context_servers": {},
      },
    },
  },
  "wrap_guides": [180],
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all",
  },
  "auto_signature_help": true,
  "show_edit_predictions": true,
  "hover_popover_enabled": true,
  "tab_bar": {
    "show_tab_bar_buttons": true,
    "show": true,
    "show_nav_history_buttons": false,
  },
  "show_whitespaces": "selection",
  "theme": "Zedokai (Filter Octagon)",
  "ui_font_size": 15.0,
  "ui_font_family": "Maple Mono NF",
  "ui_font_weight": 100.0,
  "buffer_font_size": 13.0,
  "buffer_font_family": "Maple Mono NF",
  "buffer_font_weight": 250.0,
  "terminal": {
    "option_as_meta": true,
  },
  "git": {
    "inline_blame": {
      "location": "status_bar",
      "enabled": false,
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {},
    },
  },
  "format_on_save": "on",
  "helix_mode": false,
  "vim_mode": true,
}
